# temp-agent 环境变量配置
# 注意：不要提交此文件到版本控制系统

# ============ LLM 配置 ============
# MODEL API Key
MODEL_API_KEY=sk-cp-EklY2AE0FLRB04IJEQr0HYri3Tn5BnwR2SFMReRQfZ8_62IAppW5ro_JLr-O0eCAhfIpbLxzicvgHUjPkjemA84l2twDfHtWyfOVNig3Xvft9xahdVkxscU

# MODEL API Base URL（可选，用于代理或自建模型）
MODEL_BASE_URL=https://api.minimaxi.com/v1

# 默认模型名称
MODEL_NAME=MiniMax-M2.5

# ============ 服务器配置 ============
# API 服务地址
API_HOST=0.0.0.0
API_PORT=8008
API_PREFIX=/api/ai

# ============ 后端业务接口配置 ============
# 后端 API 地址（Agent 调用业务接口时使用）
BACKEND_API_HOST=http://8.130.95.223:8688

# 后端 API 前缀（如 /api）
BACKEND_API_PREFIX=/api

# ============ 会话配置 ============
# 上下文压缩阈值（token 数量，超过此值触发压缩）
CONTEXT_TOKEN_LIMIT=200000
# 压缩后保留的最近消息数
COMPRESSION_KEEP_RECENT=20

# 最大并发请求数
MAX_CONCURRENT_REQUESTS=10

# ============ Redis 配置 ============
# Redis 连接 URL（会话存储）
# REDIS_URL=redis://:fa@report@8.130.95.223:6380/0
REDIS_URL=redis://localhost:6380/0
# ============ 定时任务配置 ============
# 启用定时任务（true/false）
SCHEDULER_ENABLED=true

# 会话保留天数（过期自动清理）
SESSION_RETENTION_DAYS=30

# ============ 日志配置 ============
LOG_LEVEL=INFO
DEBUG=false
LOG_FILE=./logs/agent.log
